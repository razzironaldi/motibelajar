-- JWT fixture helper. Tests call this before querying as an authenticated actor.
create or replace function public.test_as(p_user_id uuid)
returns void language sql security definer set search_path = pg_catalog, public
as $$ select set_config('request.jwt.claims', json_build_object('sub', p_user_id::text, 'role', 'authenticated')::text, true) $$;
revoke all on function public.test_as(uuid) from public;
grant execute on function public.test_as(uuid) to postgres;
